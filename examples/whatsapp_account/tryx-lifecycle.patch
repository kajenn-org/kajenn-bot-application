--- a/src/clients/advanced.rs
+++ b/src/clients/advanced.rs
@@ -42,6 +42,38 @@
 
 #[pymethods]
 impl AdvancedClient {
+    /// Wait until the run loop publishes its client, before any network handshake.
+    fn wait_for_client<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyAny>> {
+        let mut receiver = self.client_rx.clone();
+        let locals = get_current_locals(py)?;
+        future_into_py_with_locals(py, locals, async move {
+            receiver.wait_for(|client| client.is_some()).await.map_err(|_| {
+                PyErr::new::<pyo3::exceptions::PyRuntimeError, _>("Client startup ended")
+            })?;
+            Ok(())
+        })
+    }
+
+    /// Gracefully disconnect while preserving the device for a later run.
+    fn disconnect<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyAny>> {
+        let client = self.get_client()?;
+        let locals = get_current_locals(py)?;
+        future_into_py_with_locals(py, locals, async move {
+            client.disconnect().await;
+            Ok(())
+        })
+    }
+
+    /// Request device removal and stop; remote removal is best-effort upstream.
+    fn logout<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyAny>> {
+        let client = self.get_client()?;
+        let locals = get_current_locals(py)?;
+        future_into_py_with_locals(py, locals, async move {
+            client.logout().await;
+            Ok(())
+        })
+    }
+
     fn is_logged_in(&self) -> PyResult<bool> {
         Ok(self.get_client()?.is_logged_in())
     }
